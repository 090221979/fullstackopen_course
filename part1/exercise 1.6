// Your task is to implement a web application for collecting customer feedback. There are only three options for feedback: good, neutral, and bad.

// The application must display the total number of collected feedback for each category

import React,{useState} from 'react'

const Button = ({onClick,text})=> <button onClick={onClick}>{text}</button>

export default function App()
{

  const[good,setGood] = useState(0)
  const[bad,setBad] = useState(0)
  const[nuetral,setNuetral] = useState(0)

  const positive = ()=> setGood(good + 1)
  const negative = ()=> setBad(bad + 1)
  const mild = ()=> setNuetral(nuetral + 1)
  
  return(
    <div>
      <h2>Give Feedback</h2>
      <div>
        <Button onClick={positive} text='Good'/>
        <Button onClick={mild} text='Nuetral'/>
        <Button onClick={negative} text ='Bad'/>
      </div>
      <h2>Statistics</h2>
      <div>
        <p>Good: {good}</p>
        <p>Bad: {bad}</p>
        <p>Neutral: {nuetral}</p>
      </div>
    </div>
  )
}
